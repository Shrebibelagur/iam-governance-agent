# ---- LLM provider ----
LLM_PROVIDER=anthropic            # anthropic | azure
LLM_MODEL=claude-sonnet-5         # check current model names at docs.claude.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Entra app registration (the agent's identity) ----
TENANT_ID=your-tenant-guid
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-client-secret-value

# ---- Behaviour ----
STALE_DAYS_DEFAULT=90
DRY_RUN=true                      # true = write tools log the proposal but never call the directory
